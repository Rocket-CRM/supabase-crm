<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rocket.supabase-crm.daily-docs-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/daily-requirements-publish-and-reconcile.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/supabase-crm-daily-docs-sync.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/supabase-crm-daily-docs-sync.err.log</string>
</dict>
</plist>
